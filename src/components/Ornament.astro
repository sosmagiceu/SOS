---
/**
 * Every ornament PNG is 1440x804 with the artwork floating in the middle, so
 * dropping one in as-is leaves a big empty gap above and below it. `trimTop` /
 * `trimBottom` are that transparent padding measured per file, expressed as a
 * share of the image width — the units the negative margins in `.page-ornament`
 * need to cancel it out.
 */
const ORNAMENTS = {
  /** Mermaid-tail knot with crystals. Closing flourish above the footer. */
  sigil: {
    file: 'modern_luxury_mermaid_sigil_divider%2C_202606071802%20(2).png',
    trimTop: 11.4,
    trimBottom: 11,
  },
  /** Jellyfish and coral around a galaxy orb. Section divider. */
  ocean: {
    file: 'luxury_horizontal_mermaid_ocean_sigil%2C_202606071806.png',
    trimTop: 7.7,
    trimBottom: 8.3,
  },
  /** Fins, swirls and pearls with tapered ends. Section divider. */
  waves: {
    file: 'modern_luxury_mermaid_sigil_divider%2C_202606071802%20(1).png',
    trimTop: 13.3,
    trimBottom: 13.3,
  },
};

interface Props {
  name?: keyof typeof ORNAMENTS;
  /**
   * Space around the visible artwork, in px, on top of whatever the surrounding
   * layout already provides. Negative values pull the ornament into that space,
   * which is how you tighten it against a section that carries its own padding.
   */
  gap?: number;
  gapBottom?: number;
  /** Any CSS width value. */
  width?: string;
}

const { name = 'sigil', gap = 18, gapBottom = gap, width = 'min(100%, 760px)' } = Astro.props;
const { file, trimTop, trimBottom } = ORNAMENTS[name];
---
<div
  class="page-ornament"
  style={`--ornament-width:${width};--ornament-gap-top:${gap}px;--ornament-gap-bottom:${gapBottom}px;--ornament-trim-top:${trimTop}%;--ornament-trim-bottom:${trimBottom}%`}
  aria-hidden="true"
>
  <img src={`https://sosmagic.b-cdn.net/fotos/${file}`} alt="" loading="lazy" decoding="async">
</div>
